# Backend environment example
GEMINI_API_KEY=
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ADMIN_EMAILS=admin@empresa.com

# URL do Frontend (utilizado para gerar links de e-mail de recuperação de senha)
FRONTEND_URL=http://localhost:3000

# Base de Dados:
# Para SQLite local: sqlite:///./recrutamento.db
# Para PostgreSQL em produção: postgresql://usuario:senha@localhost:5432/recrutamento_rh
DATABASE_URL=sqlite:///./recrutamento.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ENV=development

# -------------------------------------------------------------
# Configuração de E-mails Transacionais (SMTP ou Resend API)
# Se não configurado, o sistema usa o modo Console/Mock seguro em desenvolvimento.
# -------------------------------------------------------------
# Opção 1: Resend HTTP API
RESEND_API_KEY=

# Opção 2: SMTP padrão (Gmail, SendGrid, Mailtrap, Amazon SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@recrutamento.empresa.com
SMTP_FROM_NAME=Plataforma de Recrutamento RH
SMTP_USE_TLS=true
