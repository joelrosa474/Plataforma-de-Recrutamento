# Chaves e Segredos de Autenticação e IA
GEMINI_API_KEY=your-google-gemini-api-key-here
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ADMIN_EMAILS=admin@example.com

# URL do Frontend (utilizado para gerar links de e-mail de recuperação de senha)
# Em produção, coloque o URL exato do Vercel:
FRONTEND_URL=https://plataforma-de-recrutamento-rouge.vercel.app

# Base de Dados:
# Para SQLite local: sqlite:///./recrutamento.db
# Para PostgreSQL em produção: postgresql://usuario:senha@localhost:5432/recrutamento_rh
DATABASE_URL=sqlite:///./recrutamento.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Origens CORS separadas por vírgula
# Em produção, inclua o URL do Vercel:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://plataforma-de-recrutamento-rouge.vercel.app
APP_ENV=development

# -------------------------------------------------------------
# Configuração de E-mails Transacionais (SMTP ou Resend API)
# Se não preenchido, o sistema opera no modo Console/Mock seguro em desenvolvimento.
# -------------------------------------------------------------
# Opção 1: Resend HTTP API
RESEND_API_KEY=

# Opção 2: SMTP padrão (Gmail, SendGrid, Mailtrap, Amazon SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@recrutamento.empresa.com
SMTP_FROM_NAME=Plataforma de Recrutamento RH
SMTP_USE_TLS=true
